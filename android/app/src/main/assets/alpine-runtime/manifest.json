    "note": "PRoot 5.1.107.92 rebuilt for Android from the pinned Termux source with the bounded fork-child recovery and Android outer-seccomp compatibility patches below; dependent libraries remain the pinned Termux artifacts",
    "patches": [
      {
        "change": "DT_NEEDED/DT_SONAME string libtalloc.so.2 -> libtalloc.so (in-place NUL re-termination, identical length, library bytes unchanged)",
        "files": [
          "proot",
          "libtalloc.so"
        ],
        "reason": "Android JNI-library packaging ships only lib*.so file names; the dependency is resolved by the shortened name via LD_LIBRARY_PATH"
      },
      {
        "change": "Recover a unique uninitialized fork/clone child, including pending SIGSTOP entries and CLONE_THREAD tasks, using host Tgid/PPid/TracerPid from /proc; fail explicitly if recovery is missing or ambiguous",
        "files": [
          "proot"
        ],
        "reason": "The child stop can precede its parent's event, and thread IDs are absent from /proc directory enumeration. Accept only this tracer's uninitialized child with the clone-appropriate relationship; avoid lookup side effects and PID-order guesses",
        "sourcePatch": "scripts/alpine-poc/proot-android-fork-child.patch"
      },
      {
        "change": "Handle Android outer-seccomp traps for fchmodat, chdir/fchdir/getcwd, faccessat/faccessat2, renameat2, and guest identity calls inside PRoot's seccomp event path",
        "files": [
          "proot"
        ],
        "reason": "Android 16 app processes can inherit a zygote seccomp policy that returns ENOSYS for filesystem calls even when PRoot's own seccomp filter is disabled; these bounded handlers preserve guest path state and compatibility",
        "sourcePatch": "scripts/alpine-poc/proot-android-fork-child.patch"
      }
    ]
  }
